{
  "schemaVersion": 1,
  "month": "2027-02",
  "version": "60492dc8f86f",
  "cards": [
    {
      "id": "2027-02-01",
      "date": "2027-02-01",
      "text": "会当凌绝顶，\n一览众山小。",
      "author": "杜甫",
      "source": "望岳",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-02",
      "date": "2027-02-02",
      "text": "晴空一鹤排云上，\n便引诗情到碧霄。",
      "author": "刘禹锡",
      "source": "秋词·其一",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-03",
      "date": "2027-02-03",
      "text": "等闲识得东风面，\n万紫千红总是春。",
      "author": "朱熹",
      "source": "春日",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-04",
      "date": "2027-02-04",
      "text": "小荷才露尖尖角，\n早有蜻蜓立上头。",
      "author": "杨万里",
      "source": "小池",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-05",
      "date": "2027-02-05",
      "text": "迟日江山丽，\n春风花草香。",
      "author": "杜甫",
      "source": "绝句二首·其一",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-06",
      "date": "2027-02-06",
      "text": "深林人不知，\n明月来相照。",
      "author": "王维",
      "source": "竹里馆",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-07",
      "date": "2027-02-07",
      "text": "沉舟侧畔千帆过，\n病树前头万木春。",
      "author": "刘禹锡",
      "source": "酬乐天扬州初逢席上见赠",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-08",
      "date": "2027-02-08",
      "text": "桃花潭水深千尺，\n不及汪伦送我情。",
      "author": "李白",
      "source": "赠汪伦",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-09",
      "date": "2027-02-09",
      "text": "水光潋滟晴方好，\n山色空蒙雨亦奇。",
      "author": "苏轼",
      "source": "饮湖上初晴后雨二首·其二",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-10",
      "date": "2027-02-10",
      "text": "千磨万击还坚劲，\n任尔东西南北风。",
      "author": "郑燮",
      "source": "竹石",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-11",
      "date": "2027-02-11",
      "text": "自能窥宋玉，\n何必恨王昌。",
      "author": "鱼玄机",
      "source": "赠邻女",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-12",
      "date": "2027-02-12",
      "text": "生当作人杰，\n死亦为鬼雄。",
      "author": "李清照",
      "source": "夏日绝句",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-13",
      "date": "2027-02-13",
      "text": "但愿人长久，\n千里共婵娟。",
      "author": "苏轼",
      "source": "水调歌头·明月几时有",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-14",
      "date": "2027-02-14",
      "text": "遥知不是雪，\n为有暗香来。",
      "author": "王安石",
      "source": "梅花",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-15",
      "date": "2027-02-15",
      "text": "今夜月明人尽望，\n不知秋思落谁家。",
      "author": "王建",
      "source": "十五夜望月寄杜郎中",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-16",
      "date": "2027-02-16",
      "text": "鸡声茅店月，\n人迹板桥霜。",
      "author": "温庭筠",
      "source": "商山早行",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-17",
      "date": "2027-02-17",
      "text": "只在此山中，\n云深不知处。",
      "author": "贾岛",
      "source": "寻隐者不遇",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-18",
      "date": "2027-02-18",
      "text": "江流天地外，\n山色有无中。",
      "author": "王维",
      "source": "汉江临泛",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-19",
      "date": "2027-02-19",
      "text": "野旷天低树，\n江清月近人。",
      "author": "孟浩然",
      "source": "宿建德江",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-20",
      "date": "2027-02-20",
      "text": "无可奈何花落去，\n似曾相识燕归来。",
      "author": "晏殊",
      "source": "浣溪沙·一曲新词酒一杯",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-21",
      "date": "2027-02-21",
      "text": "明月别枝惊鹊，\n清风半夜鸣蝉。",
      "author": "辛弃疾",
      "source": "西江月·夜行黄沙道中",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-22",
      "date": "2027-02-22",
      "text": "行到水穷处，\n坐看云起时。",
      "author": "王维",
      "source": "终南别业",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-23",
      "date": "2027-02-23",
      "text": "人间有味是清欢。",
      "author": "苏轼",
      "source": "浣溪沙·细雨斜风作晓寒",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-24",
      "date": "2027-02-24",
      "text": "海上生明月，\n天涯共此时。",
      "author": "张九龄",
      "source": "望月怀远",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-25",
      "date": "2027-02-25",
      "text": "长风破浪会有时，\n直挂云帆济沧海。",
      "author": "李白",
      "source": "行路难·其一",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-02-26",
      "date": "2027-02-26",
      "text": "明月松间照，\n清泉石上流。",
      "author": "王维",
      "source": "山居秋暝",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-02-27",
      "date": "2027-02-27",
      "text": "采菊东篱下，\n悠然见南山。",
      "author": "陶渊明",
      "source": "饮酒·其五",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-02-28",
      "date": "2027-02-28",
      "text": "欲穷千里目，\n更上一层楼。",
      "author": "王之涣",
      "source": "登鹳雀楼",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    }
  ]
}

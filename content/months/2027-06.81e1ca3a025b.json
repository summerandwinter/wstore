{
  "schemaVersion": 1,
  "month": "2027-06",
  "version": "81e1ca3a025b",
  "cards": [
    {
      "id": "2027-06-01",
      "date": "2027-06-01",
      "text": "但愿人长久，\n千里共婵娟。",
      "author": "苏轼",
      "source": "水调歌头·明月几时有",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-02",
      "date": "2027-06-02",
      "text": "遥知不是雪，\n为有暗香来。",
      "author": "王安石",
      "source": "梅花",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-03",
      "date": "2027-06-03",
      "text": "今夜月明人尽望，\n不知秋思落谁家。",
      "author": "王建",
      "source": "十五夜望月寄杜郎中",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-04",
      "date": "2027-06-04",
      "text": "鸡声茅店月，\n人迹板桥霜。",
      "author": "温庭筠",
      "source": "商山早行",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-05",
      "date": "2027-06-05",
      "text": "只在此山中，\n云深不知处。",
      "author": "贾岛",
      "source": "寻隐者不遇",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-06",
      "date": "2027-06-06",
      "text": "江流天地外，\n山色有无中。",
      "author": "王维",
      "source": "汉江临泛",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-07",
      "date": "2027-06-07",
      "text": "野旷天低树，\n江清月近人。",
      "author": "孟浩然",
      "source": "宿建德江",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-08",
      "date": "2027-06-08",
      "text": "无可奈何花落去，\n似曾相识燕归来。",
      "author": "晏殊",
      "source": "浣溪沙·一曲新词酒一杯",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-09",
      "date": "2027-06-09",
      "text": "明月别枝惊鹊，\n清风半夜鸣蝉。",
      "author": "辛弃疾",
      "source": "西江月·夜行黄沙道中",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-10",
      "date": "2027-06-10",
      "text": "行到水穷处，\n坐看云起时。",
      "author": "王维",
      "source": "终南别业",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-11",
      "date": "2027-06-11",
      "text": "人间有味是清欢。",
      "author": "苏轼",
      "source": "浣溪沙·细雨斜风作晓寒",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-12",
      "date": "2027-06-12",
      "text": "海上生明月，\n天涯共此时。",
      "author": "张九龄",
      "source": "望月怀远",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-13",
      "date": "2027-06-13",
      "text": "长风破浪会有时，\n直挂云帆济沧海。",
      "author": "李白",
      "source": "行路难·其一",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-14",
      "date": "2027-06-14",
      "text": "明月松间照，\n清泉石上流。",
      "author": "王维",
      "source": "山居秋暝",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-15",
      "date": "2027-06-15",
      "text": "采菊东篱下，\n悠然见南山。",
      "author": "陶渊明",
      "source": "饮酒·其五",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-16",
      "date": "2027-06-16",
      "text": "欲穷千里目，\n更上一层楼。",
      "author": "王之涣",
      "source": "登鹳雀楼",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-17",
      "date": "2027-06-17",
      "text": "春眠不觉晓，\n处处闻啼鸟。",
      "author": "孟浩然",
      "source": "春晓",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-18",
      "date": "2027-06-18",
      "text": "随风潜入夜，\n润物细无声。",
      "author": "杜甫",
      "source": "春夜喜雨",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-19",
      "date": "2027-06-19",
      "text": "山重水复疑无路，\n柳暗花明又一村。",
      "author": "陆游",
      "source": "游山西村",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-20",
      "date": "2027-06-20",
      "text": "愿君多采撷，\n此物最相思。",
      "author": "王维",
      "source": "相思",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-21",
      "date": "2027-06-21",
      "text": "相看两不厌，\n只有敬亭山。",
      "author": "李白",
      "source": "独坐敬亭山",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-22",
      "date": "2027-06-22",
      "text": "海内存知己，\n天涯若比邻。",
      "author": "王勃",
      "source": "送杜少府之任蜀州",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-23",
      "date": "2027-06-23",
      "text": "潮平两岸阔，\n风正一帆悬。",
      "author": "王湾",
      "source": "次北固山下",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-24",
      "date": "2027-06-24",
      "text": "竹杖芒鞋轻胜马，\n谁怕？一蓑烟雨任平生。",
      "author": "苏轼",
      "source": "定风波·莫听穿林打叶声",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-25",
      "date": "2027-06-25",
      "text": "会当凌绝顶，\n一览众山小。",
      "author": "杜甫",
      "source": "望岳",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-26",
      "date": "2027-06-26",
      "text": "晴空一鹤排云上，\n便引诗情到碧霄。",
      "author": "刘禹锡",
      "source": "秋词·其一",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-27",
      "date": "2027-06-27",
      "text": "等闲识得东风面，\n万紫千红总是春。",
      "author": "朱熹",
      "source": "春日",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-28",
      "date": "2027-06-28",
      "text": "小荷才露尖尖角，\n早有蜻蜓立上头。",
      "author": "杨万里",
      "source": "小池",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-29",
      "date": "2027-06-29",
      "text": "迟日江山丽，\n春风花草香。",
      "author": "杜甫",
      "source": "绝句二首·其一",
      "category": "诗词",
      "background": "sea",
      "template": "paper",
      "revision": 1
    },
    {
      "id": "2027-06-30",
      "date": "2027-06-30",
      "text": "深林人不知，\n明月来相照。",
      "author": "王维",
      "source": "竹里馆",
      "category": "诗词",
      "background": "dusk",
      "template": "paper",
      "revision": 1
    }
  ]
}

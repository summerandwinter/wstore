{
  "schemaVersion": 1,
  "month": "2027-03",
  "version": "6a758d428579",
  "cards": [
    {
      "id": "2027-03-01",
      "date": "2027-03-01",
      "text": "烟水悠悠,有句相酬,无计相留.#折桂令#",
      "author": "张可久",
      "source": "张可久散曲集",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-02",
      "date": "2027-03-02",
      "text": "十步杀一人，千里不留行。事了拂衣去，深藏身与名。#侠客行#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-03",
      "date": "2027-03-03",
      "text": "我本楚狂人，凤歌笑孔丘。",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-04",
      "date": "2027-03-04",
      "text": "今人不见古时月，今月曾经照古人。#把酒问月#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-05",
      "date": "2027-03-05",
      "text": "云想衣裳花想容， 春风拂槛露华浓。 #清平调#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-06",
      "date": "2027-03-06",
      "text": "挑雪雪已冻，挖雪声砰粼。一儿忽叫呼，弃鉏走且奔。拉众前往视，鉏下雪深乃有冻死人。",
      "author": "邓文滨",
      "source": "醒睡录",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-07",
      "date": "2027-03-07",
      "text": "高城鼓动兰釭灺，睡也还醒。醉也还醒。忽听孤鸿三两声。\n人生只似风前絮，欢也零星。悲也零星。都作连江点点萍。",
      "author": "佚名",
      "source": "采桑子",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-08",
      "date": "2027-03-08",
      "text": "任你官清似水，难逃吏滑如油。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-09",
      "date": "2027-03-09",
      "text": "种瓜得瓜，种豆得豆。\n一切祸福，自作自受。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-10",
      "date": "2027-03-10",
      "text": "可怜三尺无情土，盖却多情年少人。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-11",
      "date": "2027-03-11",
      "text": "药医不死病，佛渡有缘人。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-12",
      "date": "2027-03-12",
      "text": "事非干己休多管，话不投机莫强言。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-13",
      "date": "2027-03-13",
      "text": "不是一番寒彻骨，怎得梅花扑鼻香。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-14",
      "date": "2027-03-14",
      "text": "人不可貌相，海水不可斗量",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-15",
      "date": "2027-03-15",
      "text": "观棋不语真君子，把酒多言是小人。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-16",
      "date": "2027-03-16",
      "text": "舌为利害本，口是祸福门。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-17",
      "date": "2027-03-17",
      "text": "古人结交在意气，今人结交为势利。\n从来势利不同心，何如意气交情深。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-18",
      "date": "2027-03-18",
      "text": "青龙白虎同行，凶吉全然未保。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-19",
      "date": "2027-03-19",
      "text": "梦中识想非全假，白日奔驰莫认真。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-20",
      "date": "2027-03-20",
      "text": "湖上雪，风急堕还多。轻片有时敲竹户，素华无韵入澄波，望外玉相磨。\n湖水远，天地色相和。仰面莫思梁苑赋，朝来且听玉人歌，不醉拟如何？",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-21",
      "date": "2027-03-21",
      "text": "山明水秀，风软云闲。一岩风景如屏，满目松筠似画。轻烟淡淡，数声啼鸟落花天；丽日融融，是处绿杨芳草地。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-22",
      "date": "2027-03-22",
      "text": "运来自有因缘到，到手休嫌早共迟。",
      "author": "冯梦龙",
      "source": "醒世恒言",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-23",
      "date": "2027-03-23",
      "text": "杀人须就咽喉上着刀，吾人为学，当从心髓入微处用力，自然笃实光辉。",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-24",
      "date": "2027-03-24",
      "text": "无事时存养，有事时省察！",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-25",
      "date": "2027-03-25",
      "text": "一念开明，反身而诚",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-26",
      "date": "2027-03-26",
      "text": "无善无恶心之体，有善有恶意之动。知善知恶是良知，为善去恶是格物。",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-27",
      "date": "2027-03-27",
      "text": "种树者必培其根，种德者必养其心。",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2027-03-28",
      "date": "2027-03-28",
      "text": "如得其情,则哀矜而勿喜。【论语·子张】\n\n很多人这样引用：若得其情，哀矜勿喜。",
      "author": "孔子",
      "source": "论语",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-29",
      "date": "2027-03-29",
      "text": "成事不说，遂事不谏，既往不咎。",
      "author": "孔子",
      "source": "论语",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2027-03-30",
      "date": "2027-03-30",
      "text": "林放问礼之本,子曰：“大哉问！礼，与其奢也，宁俭；丧，与其易也，宁戚。”",
      "author": "孔子",
      "source": "论语",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2027-03-31",
      "date": "2027-03-31",
      "text": "子贡曰：“纣之不善，不如是之甚也。是以君子恶居下流，天下之恶皆归焉。”",
      "author": "孔子",
      "source": "论语",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    }
  ]
}

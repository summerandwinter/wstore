{
  "schemaVersion": 1,
  "month": "2029-09",
  "version": "3a577759be77",
  "cards": [
    {
      "id": "2029-09-01",
      "date": "2029-09-01",
      "text": "桃花潭水深千尺，\n不及汪伦送我情。",
      "author": "李白",
      "source": "赠汪伦",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-02",
      "date": "2029-09-02",
      "text": "水光潋滟晴方好，\n山色空蒙雨亦奇。",
      "author": "苏轼",
      "source": "饮湖上初晴后雨二首·其二",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-03",
      "date": "2029-09-03",
      "text": "千磨万击还坚劲，\n任尔东西南北风。",
      "author": "郑燮",
      "source": "竹石",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-04",
      "date": "2029-09-04",
      "text": "自能窥宋玉，\n何必恨王昌。",
      "author": "鱼玄机",
      "source": "赠邻女",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-05",
      "date": "2029-09-05",
      "text": "生当作人杰，\n死亦为鬼雄。",
      "author": "李清照",
      "source": "夏日绝句",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-06",
      "date": "2029-09-06",
      "text": "但愿人长久，\n千里共婵娟。",
      "author": "苏轼",
      "source": "水调歌头·明月几时有",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-07",
      "date": "2029-09-07",
      "text": "遥知不是雪，\n为有暗香来。",
      "author": "王安石",
      "source": "梅花",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-08",
      "date": "2029-09-08",
      "text": "今夜月明人尽望，\n不知秋思落谁家。",
      "author": "王建",
      "source": "十五夜望月寄杜郎中",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-09",
      "date": "2029-09-09",
      "text": "鸡声茅店月，\n人迹板桥霜。",
      "author": "温庭筠",
      "source": "商山早行",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-10",
      "date": "2029-09-10",
      "text": "只在此山中，\n云深不知处。",
      "author": "贾岛",
      "source": "寻隐者不遇",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-11",
      "date": "2029-09-11",
      "text": "江流天地外，\n山色有无中。",
      "author": "王维",
      "source": "汉江临泛",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-12",
      "date": "2029-09-12",
      "text": "野旷天低树，\n江清月近人。",
      "author": "孟浩然",
      "source": "宿建德江",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-13",
      "date": "2029-09-13",
      "text": "无可奈何花落去，\n似曾相识燕归来。",
      "author": "晏殊",
      "source": "浣溪沙·一曲新词酒一杯",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-14",
      "date": "2029-09-14",
      "text": "明月别枝惊鹊，\n清风半夜鸣蝉。",
      "author": "辛弃疾",
      "source": "西江月·夜行黄沙道中",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-15",
      "date": "2029-09-15",
      "text": "深山必有路，绝处总逢生。",
      "author": "孟郊",
      "source": "孟东野诗集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-16",
      "date": "2029-09-16",
      "text": "如果傻瓜坚持他的愚蠢，他就会变得聪明。",
      "author": "威廉·布莱克",
      "source": "布莱克诗选",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-17",
      "date": "2029-09-17",
      "text": "众星朗朗，不如孤月独明。",
      "author": "佚名",
      "source": "增广贤文",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-18",
      "date": "2029-09-18",
      "text": "黄莺乱啼门外柳，雨细清明后。能消几日春， \n又是相思瘦。梨花小窗人病酒。\n#清江引·春思#",
      "author": "张可久",
      "source": "张可久散曲集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-19",
      "date": "2029-09-19",
      "text": "三高祠下天如镜，山色浸空蒙。 \n莼羹张翰，渔舟范蠡，茶灶龟蒙。 \n故人何在，前程那里，心事谁同。 \n黄花庭院，青灯夜雨，白发秋风。\n#人月圆 客垂虹 北曲聊乐府前集今#",
      "author": "张可久",
      "source": "张可久散曲集",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-20",
      "date": "2029-09-20",
      "text": "对青山强整乌纱。归雁横秋，倦客思家。翠袖殷勤，金杯错落，玉手琵琶。 \n人老去西风白发，蝶愁来明日黄花。回首天涯，一抹斜阳，数点寒鸦。\n#折桂令#",
      "author": "张可久",
      "source": "张可久散曲集",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-21",
      "date": "2029-09-21",
      "text": "谁家玉笛暗飞声，散入春风满洛城。",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-22",
      "date": "2029-09-22",
      "text": "早知如此绊人心，何如当初莫相识。#秋风词#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-23",
      "date": "2029-09-23",
      "text": "不恨落花有意，恨流水如丝难剪#水龙吟#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-24",
      "date": "2029-09-24",
      "text": "相思相见知何日，此时此夜难为情",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "system",
      "revision": 1
    },
    {
      "id": "2029-09-25",
      "date": "2029-09-25",
      "text": "浮生若梦，为欢几何？#春夜宴从弟桃李园序#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-26",
      "date": "2029-09-26",
      "text": "凤凰台上凤凰游，凤去台空江自流。 \n吴宫花草埋幽径，晋代衣冠成古丘。\n三山半落青天外，二水中分白鹭洲。 \n总为浮云能蔽日，长安不见使人愁。",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-27",
      "date": "2029-09-27",
      "text": "请君试问东流水，别意与之谁短长\n#金陵酒肆留别#",
      "author": "李白",
      "source": "李白诗集",
      "category": "诗词",
      "background": "mist",
      "template": "paper",
      "font": "wenkai",
      "revision": 1
    },
    {
      "id": "2029-09-28",
      "date": "2029-09-28",
      "text": "残雪凝辉冷画屏，落梅横笛已三更，更无人处月胧明。 \n我是人间惆怅客，知君何事泪纵横，断肠声里忆平生。",
      "author": "佚名",
      "source": "浣溪沙",
      "category": "诗词",
      "background": "sea",
      "template": "light",
      "font": "xiaowei",
      "revision": 1
    },
    {
      "id": "2029-09-29",
      "date": "2029-09-29",
      "text": "你未看此花时，此花与汝同归于寂；你来看此花时，则此花颜色一时明白起来，便知此花不在你的心外。",
      "author": "王阳明",
      "source": "传习录",
      "category": "诗词",
      "background": "dusk",
      "template": "type",
      "font": "system",
      "revision": 1
    }
  ]
}
